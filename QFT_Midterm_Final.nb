(* ::Package:: *)

(* ========================================================================= *)
(* QFT Midterm Project: Scalar Field Renormalization (Phi^4)                 *)
(* ========================================================================= *)



(* ::Cell:: *)
(* --- Cell 1: Package Initialization --- *)
(* Question: How to correctly load FeynCalc and the Phi4 model? | Derivation: Standard FeynCalc loading protocol | Check: Verified existence of model files | Anchor IDs: None | Status: checked *)


$LoadAddOns = {"FeynArts"};
<< FeynCalc`
modelDir = FileNameJoin[{$FeynCalcDirectory, "Examples", "Models", "Phi4"}];
{FileExistsQ[FileNameJoin[{modelDir, "Phi4.mod"}]], FileExistsQ[FileNameJoin[{modelDir, "Phi4.gen"}]]}
FAPatch[PatchModelsOnly -> True, FAModelsDirectory -> modelDir];



(* ::Cell:: *)
(* --- Cell 2: Topology Generation --- *)
(* Question: How to generate 1PI 1-loop diagrams? | Derivation: Standard 1-loop top-down insertion | Check: Topology count | Anchor IDs: EQ-01 | Status: derived *)


$D = 4 - \[Epsilon];
FCSetDiracGammaDimension[4];

topos2pt = CreateTopologies[1, 1 -> 1, ExcludeTopologies -> {WFCorrections}];
topos4pt = CreateTopologies[1, 2 -> 2, ExcludeTopologies -> {WFCorrections}];

insertions2pt = InsertFields[topos2pt, {S[1]} -> {S[1]},  InsertionLevel -> {Classes},
  Model -> FileNameJoin[{modelDir,"Phi4"}],
  GenericModel -> FileNameJoin[{modelDir,"Phi4"}]];
insertions4pt = InsertFields[topos4pt, {S[1], S[1]} -> {S[1], S[1]}, InsertionLevel -> {Classes}, Model -> FileNameJoin[{modelDir,"Phi4"}],
  GenericModel -> FileNameJoin[{modelDir,"Phi4"}]];

Print["Number of 2pt insertions: ", Length[insertions2pt]];
Print["Number of 4pt insertions: ", Length[insertions4pt]];



(* ::Cell:: *)
(* --- Cell 3: Visualization --- *)
(* Question: How to visualize the generated diagrams? | Derivation: Paint function call | Check: Visual inspection | Anchor IDs: None | Status: derived *)


Print["Painting 2pt Diagrams"];
Paint[insertions2pt, ColumnsXRows -> {2, 1}, Numbering -> Simple, SheetHeader -> None, ImageSize -> {300, 150}];

Print["Painting 4pt Diagrams"];
Paint[insertions4pt, ColumnsXRows -> {3, 1}, Numbering -> Simple, SheetHeader -> None, ImageSize -> {450, 150}];



(* ::Cell:: *)
(* --- Cell 4: Amplitude Construction & Channel Identification --- *)
(* Question: How to construct amplitude and identify kinematic channels? | Derivation: FCFAConvert with momenta routing | Check: Symmetry factors applied | Anchor IDs: EQ-02 | Status: derived *)


amp2pt = CreateFeynAmp[insertions2pt, PreFactor -> 1];
amp4pt = CreateFeynAmp[insertions4pt, PreFactor -> 1];

fcAmps2pt = FCFAConvert[amp2pt, IncomingMomenta -> {p}, OutgoingMomenta -> {p}, LoopMomenta -> {q}, ChangeDimension -> D, List -> False];
fcAmps4pt = FCFAConvert[amp4pt, IncomingMomenta -> {p1, p2}, OutgoingMomenta -> {k1, k2}, LoopMomenta -> {q}, ChangeDimension -> D, List -> False];

(* Explicit Identification of Channels *)
Print["Identifying 4-point channels (s, t, u):"];
SetMandelstam[s, t, u, p1, p2, -k1, -k2, 0, 0, 0, 0];
Print["Channel S: ", (p1 + p2)^2];
Print["Channel T: ", (p1 - k1)^2];
Print["Channel U: ", (p1 - k2)^2];



(* ::Cell:: *)
(* --- Cell 5: Tensor Reduction (ToPaVe) and Conventions --- *)
(* Question: How to reduce tensors to scalar integrals? | Derivation: TID followed by ToPaVe | Check: Divergence consistency | Anchor IDs: EQ-03 | Status: derived *)


(* Conventions: 
   - Wick Rotation: q_0 -> i q_0_E 
   - Measure: 1/(2pi)^D int d^D q
*)
topoV2pt = ToPaVe[fcAmps2pt, q];
topoV4pt = ToPaVe[fcAmps4pt, q];

Print["ToPaVe Reduced 2pt Integrals: ", topoV2pt];
Print["ToPaVe Reduced 4pt Integrals: ", topoV4pt];

(* ========================================================================= *)
(* Subsection 1.2: Cutoff and Dimensional Regularization of T and B(0)       *)
(* ========================================================================= *)



(* ::Cell:: *)
(* --- Cell 6: Sharp Cutoff Evaluation of Tadpole and Bubble (Eq. 1.5) --- *)
(* Question: How to evaluate T and B(0) for |k| < Lambda exactly and expand through Lambda^-2? | Derivation: 4D Euclidean spherical integration with u = k^2 and radial measure u du / (16 Pi^2) | Check: Exact integrals and Lambda -> Infinity expansion through Lambda^-2 | Anchor IDs: A-05 | Status: derived *)


(* Anchor: A-05 (Eq. 1.5, derived from Sasha.pdf Ch. 13, Eq. 13.2, printed p. 112 / PDF p. 113) *)
(* Convention: d = 4 sharp Euclidean cutoff |k| < Lambda, m^2 > 0 *)

ClearAll[u, m2, lamUV, cutAssumptions, tCutExact, bCutExact, tCutSeries, bCutSeries];
cutAssumptions = m2 > 0 && lamUV > 0;

tCutExact = FullSimplify[
  Integrate[u / (u + m2), {u, 0, lamUV^2}, Assumptions -> cutAssumptions] / (16 * Pi^2),
  cutAssumptions
];

bCutExact = FullSimplify[
  Integrate[u / (u + m2)^2, {u, 0, lamUV^2}, Assumptions -> cutAssumptions] / (16 * Pi^2),
  cutAssumptions
];

tCutSeries = Assuming[cutAssumptions,
  FullSimplify[Normal[Series[tCutExact, {lamUV, Infinity, 2}]]]
];

bCutSeries = Assuming[cutAssumptions,
  FullSimplify[Normal[Series[bCutExact, {lamUV, Infinity, 2}]]]
];

Print["[A-05] Sharp Cutoff Tadpole T_Lambda (exact): ", tCutExact];
Print["[A-05] Sharp Cutoff Tadpole T_Lambda (through Lambda^-2): ", tCutSeries];
Print["[A-05] Sharp Cutoff Bubble B_Lambda(0) (exact): ", bCutExact];
Print["[A-05] Sharp Cutoff Bubble B_Lambda(0) (through Lambda^-2): ", bCutSeries];


(* ::Cell:: *)
(* --- Cell 7: Dimensional Regularization (DR) Laurent Expansions (Eq. 1.4) --- *)
(* Question: What are the independent DR Laurent expansions of T and B(0) through the finite epsilon^0 term? | Derivation: Schwinger parameter and DR master integral J_a(m^2) with one mu^epsilon per loop and d = 4 - epsilon | Check: Independent evaluation of T = J_1 and B(0) = J_2 through O(epsilon^0) | Anchor IDs: A-04 | Status: derived *)


(* Anchor: A-04 (Eq. 1.4, quoted from Sasha.pdf Ch. 13, Eqs. 13.5-13.7, printed p. 114 / PDF p. 115) *)
(* Convention: d = 4 - \[Epsilon], one \[Mu]^\[Epsilon] per loop, m^2 > 0, \[Epsilon] = 2 \[Epsilon]_FC *)

ClearAll[a, mu, drAssumptions, jDR, tDRExact, bDRExact, tDRSeries, bDRSeries];
drAssumptions = m2 > 0 && mu > 0 && Element[\[Epsilon], Reals];

jDR[a_] := mu^\[Epsilon] * m2^(2 - \[Epsilon]/2 - a) *
  Gamma[a - 2 + \[Epsilon]/2] / ((4 * Pi)^(2 - \[Epsilon]/2) * Gamma[a]);

tDRExact = jDR[1];
bDRExact = jDR[2];

tDRSeries = Assuming[drAssumptions,
  FullSimplify[Normal[Series[tDRExact, {\[Epsilon], 0, 0}]]]
];

bDRSeries = Assuming[drAssumptions,
  FullSimplify[Normal[Series[bDRExact, {\[Epsilon], 0, 0}]]]
];

Print["[A-04] Exact DR Tadpole T_DR: ", tDRExact];
Print["[A-04] DR Tadpole Laurent expansion (through eps^0): ", tDRSeries];
Print["[A-04] Exact DR Bubble B_DR(0): ", bDRExact];
Print["[A-04] DR Bubble B(0) Laurent expansion (through eps^0): ", bDRSeries];


(* ::Cell:: *)
(* --- Cell 8: Divergence Classification (Power Divergences, Logarithms, and Poles) --- *)
(* Question: How are power divergences, logarithms, and 1/epsilon poles identified in both schemes? | Derivation: Extract UV-divergent coefficients from the cutoff and DR expansions | Check: Match quadratic/logarithmic cutoff terms against 1/epsilon DR poles | Anchor IDs: A-04, A-05 | Status: derived *)


tCutQuadCoeff = Coefficient[tCutSeries, lamUV^2];
tDRPoleCoeff = FullSimplify[Limit[\[Epsilon] * tDRSeries, \[Epsilon] -> 0], drAssumptions];
bDRPoleCoeff = FullSimplify[Limit[\[Epsilon] * bDRSeries, \[Epsilon] -> 0], drAssumptions];

Print["[A-05] T_Lambda quadratic divergence coeff (of Lambda^2): ", tCutQuadCoeff];
Print["[A-04] T_DR simple pole coeff (of 1/eps): ", tDRPoleCoeff];
Print["[A-04] B_DR(0) simple pole coeff (of 1/eps): ", bDRPoleCoeff];


(* ::Cell:: *)
(* --- Cell 9: Derivative Identity Verification B(0) = -dT/dm^2 --- *)
(* Question: Does B(0) = -partial T / partial m^2 hold in both sharp cutoff and DR schemes? | Derivation: Differentiate T with respect to m2 = m^2 at fixed regulator scale (Lambda or mu) | Check: Both exact and expanded differences vanish identically | Anchor IDs: A-04, A-05 | Status: derived *)


idCheckCutExact = FullSimplify[bCutExact - (-D[tCutExact, m2]), cutAssumptions];
idCheckCutSeries = FullSimplify[bCutSeries - (-D[tCutSeries, m2]), cutAssumptions];

idCheckDRExact = FullSimplify[
  (bDRExact - (-D[tDRExact, m2])) /. Gamma[\[Epsilon]/2] :> (\[Epsilon]/2 - 1) * Gamma[\[Epsilon]/2 - 1],
  drAssumptions
];
idCheckDRSeries = FullSimplify[bDRSeries - (-D[tDRSeries, m2]), drAssumptions];

Print["[A-05] Derivative identity check (Sharp Cutoff, exact): ", idCheckCutExact];
Print["[A-05] Derivative identity check (Sharp Cutoff, series): ", idCheckCutSeries];
Print["[A-04] Derivative identity check (DR, exact): ", idCheckDRExact];
Print["[A-04] Derivative identity check (DR, series): ", idCheckDRSeries];


(* ========================================================================= *)
(* Subsection 1.3: Counterterms and Regulator Independence                   *)
(* ========================================================================= *)



(* ::Cell:: *)
(* --- Cell 10: Zero-Momentum Normalization (SII) and One-Loop Counterterms --- *)
(* Question: What are deltaZphi, deltam2, and deltalambda in both regulators under SII? | Derivation: Impose Gamma^(2)(0)=m^2, dGamma^(2)/dp^2|_0=1, Gamma^(4)(0)=lambda on the 1-loop 1PI vertices | Check: All three normalization conditions vanish identically after inserting counterterms | Anchor IDs: A-06, A-07 | Status: derived *)


(* Anchor: A-06 (Zero-momentum normalization SII, Sasha.pdf Ch. 15, Eqs. 15.2-15.5, printed pp. 148-149 / PDF pp. 149-150) *)
(* Anchor: A-07 (Counterterm series deltaZ = z^(1) lambda + ..., deltam^2 = b^(1) lambda + ..., deltalambda = a^(1) lambda + ..., Sasha.pdf Ch. 13, printed p. 116 / PDF p. 117) *)
(* Convention: Euclidean signs from brief:
   Gamma^(2)(p^2) = p^2 + m^2 + deltaZphi*p^2 + deltam2 + (lambda/2)*T
   Gamma^(4)(p1,p2,p3,p4) = lambda + deltalambda - (lambda^2/2)*(B(P12) + B(P13) + B(P14)) *)

ClearAll[p2, lam, dZphi, dm2Cut, dlamCut, dm2DR, dlamDR, gamma2Cut, gamma2DR, gamma4ZeroCut, gamma4ZeroDR];

(* One-loop counterterms in sharp cutoff *)
dZphi = 0; (* Tadpole T is independent of external momentum p^2 *)
dm2Cut = -lam * tCutSeries / 2;
dlamCut = 3 * lam^2 * bCutSeries / 2;

(* One-loop counterterms in DR *)
dm2DR = -lam * tDRSeries / 2;
dlamDR = 3 * lam^2 * bDRSeries / 2;

(* Verify SII normalization conditions in both regulators *)
gamma2Cut = p2 + m2 + dZphi * p2 + dm2Cut + (lam / 2) * tCutSeries;
gamma2DR = p2 + m2 + dZphi * p2 + dm2DR + (lam / 2) * tDRSeries;
gamma4ZeroCut = lam + dlamCut - (3 * lam^2 / 2) * bCutSeries;
gamma4ZeroDR = lam + dlamDR - (3 * lam^2 / 2) * bDRSeries;

Print["[A-07] One-loop deltaZ_phi (both regulators): ", dZphi];
Print["[A-07] Sharp Cutoff delta m^2 (through Lambda^-2): ", FullSimplify[dm2Cut, cutAssumptions]];
Print["[A-07] Sharp Cutoff delta lambda (through Lambda^-2): ", FullSimplify[dlamCut, cutAssumptions]];
Print["[A-07] DR delta m^2 (through eps^0): ", FullSimplify[dm2DR, drAssumptions]];
Print["[A-07] DR delta lambda (through eps^0): ", FullSimplify[dlamDR, drAssumptions]];
Print["[A-06] SII Check (Cutoff): ", FullSimplify[{gamma2Cut /. p2 -> 0, D[gamma2Cut, p2] /. p2 -> 0, gamma4ZeroCut}, cutAssumptions]];
Print["[A-06] SII Check (DR): ", FullSimplify[{gamma2DR /. p2 -> 0, D[gamma2DR, p2] /. p2 -> 0, gamma4ZeroDR}, drAssumptions]];


(* ::Cell:: *)
(* --- Cell 11: Subtracted Bubble B(P) - B(0) and Regulator Independence --- *)
(* Question: Do B(P) - B(0) and its slope at P^2 = 0 agree in DR and sharp cutoff as regulators are removed? | Derivation: Feynman parametrization (Eq. 13.20) for DR; form convergent difference before taking Lambda -> Infinity and shifting loop momentum for sharp cutoff | Check: Identical finite integral representation and slope B'(0) = -1/(96 Pi^2 m^2) | Anchor IDs: A-08, A-09 | Status: derived *)


(* Anchor: A-08 (Feynman parametrization, Sasha.pdf Ch. 13, Eq. 13.20, printed p. 121 / PDF p. 122) *)
(* Anchor: A-09 (Subtracted bubble and slope, Sasha.pdf Ch. 13, Eqs. 13.19 & 13.21, printed pp. 120-122 / PDF pp. 121-123) *)
(* Cutoff warning: First form the convergent difference B_Lambda(P) - B_Lambda(0), take Lambda -> Infinity so the integral is absolutely convergent in d = 4, and only then shift loop momentum k -> k - x P. *)

ClearAll[x, P2, subBubbleDR, subBubbleCut, bDiffClosed, bSlopeDR, bSlopeCut];

(* DR: B_DR(P) - B_DR(0) from Feynman parametrization in d = 4 - eps, then eps -> 0 *)
subBubbleDR = Assuming[drAssumptions && P2 > 0 && 0 < x < 1,
  FullSimplify[
    Normal[Series[
      mu^\[Epsilon] * Gamma[\[Epsilon]/2] / (4 * Pi)^(2 - \[Epsilon]/2) *
        ((m2 + x * (1 - x) * P2)^(-\[Epsilon]/2) - m2^(-\[Epsilon]/2)),
      {\[Epsilon], 0, 0}
    ]]
  ]
];

(* Sharp cutoff: after forming B_Lambda(P) - B_Lambda(0), taking Lambda -> Infinity, and Feynman-parametrizing,
   the convergent d = 4 radial integral Int_0^Infinity u du [(u + m^2 + x(1-x)P^2)^(-2) - (u + m^2)^(-2)] / (16 Pi^2) gives: *)
subBubbleCut = Assuming[m2 > 0 && P2 > 0 && 0 < x < 1,
  FullSimplify[
    Limit[
      Integrate[u * (1 / (u + m2 + x * (1 - x) * P2)^2 - 1 / (u + m2)^2), {u, 0, lamUV^2},
        Assumptions -> m2 > 0 && P2 > 0 && lamUV > 0 && 0 < x < 1] / (16 * Pi^2),
      lamUV -> Infinity
    ]
  ]
];

(* Closed-form subtracted bubble after integrating over Feynman parameter x in [0, 1] *)
bDiffClosed = Assuming[m2 > 0 && P2 > 0,
  FullSimplify[Integrate[subBubbleDR, {x, 0, 1}]]
];

(* Slope d/d(P^2) [B(P) - B(0)] at P^2 = 0 *)
bSlopeDR = Assuming[m2 > 0, FullSimplify[Integrate[D[subBubbleDR, P2] /. P2 -> 0, {x, 0, 1}]]];
bSlopeCut = Assuming[m2 > 0, FullSimplify[Integrate[D[subBubbleCut, P2] /. P2 -> 0, {x, 0, 1}]]];

Print["[A-08, A-09] DR integrand for B(P) - B(0): ", subBubbleDR];
Print["[A-08, A-09] Cutoff integrand for B(P) - B(0) (Lambda -> Inf): ", subBubbleCut];
Print["[A-09] Integrand difference (DR - Cutoff): ", FullSimplify[subBubbleDR - subBubbleCut, m2 > 0 && P2 > 0 && 0 < x < 1]];
Print["[A-09] Closed-form B(P) - B(0): ", bDiffClosed];
Print["[A-09] Slope B'(0) in DR: ", bSlopeDR];
Print["[A-09] Slope B'(0) in Cutoff: ", bSlopeCut];





(* ========================================================================= *)
(* Subsection 1.4: Minimal Subtraction Beta Function and Fixed Point         *)
(* ========================================================================= *)



(* ::Cell:: *)
(* --- Cell 12: MS Bare Coupling, One-Loop Beta Function, and Fixed Point --- *)
(* Question: What are beta_g through O(g^2) and the Wilson-Fisher fixed point g* through O(eps) in MS? | Derivation: Retain only DR 1/eps pole counterterms (MS), express lambda_0 in terms of g = lambda/(16 Pi^2), and impose mu d(lambda_0)/dmu = 0 | Check: beta_g = -eps*g + 3*g^2 and g* = eps/3 match Ch. 15 Eq. 15.19 and Ch. 21 Eq. 21.9 | Anchor IDs: A-10, A-11, A-12 | Status: derived *)


(* Anchor: A-10 (Canonical dimensions & power counting, Sasha.pdf Ch. 12, Eqs. 12.2-12.4, printed pp. 108-109 / PDF pp. 109-110) *)
(* Anchor: A-11 (MS bare coupling & pole counterterms, Sasha.pdf Ch. 13 Eq. 13.22 p. 122 & Ch. 21 Eq. 21.2 p. 216) *)
(* Anchor: A-12 (One-loop beta function & Wilson-Fisher fixed point, Sasha.pdf Ch. 15 Eq. 15.19 p. 156 & Ch. 21 Eqs. 21.9, 21.11 p. 220) *)
(* Notice: MS keeps ONLY the 1/eps pole part of the counterterms, distinct from the finite SII subtractions in Cell 10.
   Because deltaZ_phi = 0 at one loop (tadpole is p^2-independent), Z_phi = 1 + O(g^2) and gamma_phi = O(g^2),
   so the tadpole cannot shift the momentum exponent at one loop. *)

ClearAll[g, gOfMu, lam0MS, dZphiMS, zLamMS, betaEq, betaSol, betaG, gStar];

(* MS counterterms (pure 1/eps poles only):
   B_DR(0)|_pole = 2 / (16 Pi^2 eps), so delta lambda_MS = (3/2) lambda^2 * 2 / (16 Pi^2 eps) = 3 lambda^2 / (16 Pi^2 eps).
   With g = lambda / (16 Pi^2) and Z_phi = 1 + O(g^2): *)


dZphiMS = 0;
zLamMS = 1 + 3 * g / \[Epsilon];
lam0MS = 16 * Pi^2 * mu^\[Epsilon] * gOfMu[mu] * (1 + 3 * gOfMu[mu] / \[Epsilon]);

(* Impose mu d(lambda_0)/dmu = 0 at fixed bare coupling, solve for gOfMu'[mu], then multiply by mu *)
betaEq = Expand[mu * D[lam0MS, mu] / (16 * Pi^2 * mu^\[Epsilon])] == 0;
betaSol = Simplify[(mu * gOfMu'[mu] /. First[Solve[betaEq, gOfMu'[mu]]]) /. gOfMu[mu] -> g];
betaG = Normal[Series[betaSol, {g, 0, 2}]];

(* Nonzero Wilson-Fisher fixed point beta_g(g) *)
gStar = First[Select[g /. Solve[betaG == 0, g], # =!= 0 &]];

Print["[A-11] One-loop MS field counterterm deltaZ_phi,MS: ", dZphiMS];
Print["[A-11] Bare coupling lambda_0 in MS (through O(g^2)): ", lam0MS /. gOfMu[mu] -> g];
Print["[A-12] Exact one-loop solve for beta_g before truncation: ", betaSol];
Print["[A-12] MS beta function beta_g (through O(g^2)): ", betaG];
Print["[A-12] Nonzero Wilson-Fisher fixed point g* (through O(eps)): ", gStar];



